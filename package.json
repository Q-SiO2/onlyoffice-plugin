{
  "name": "paloalto-live",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "backend",
    "participant-app",
    "onlyoffice-plugin",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch backend/src/index.ts\" \"vite --host 0.0.0.0\"",
    "demo": "tsx scripts/demo.ts",
    "build": "npm run typecheck && vite build && tsx scripts/build.ts",
    "start": "node dist/backend/index.js",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "simulate": "tsx scripts/simulate.ts",
    "import:class": "tsx scripts/import-class.ts",
    "package:plugin": "tsx scripts/package-plugin.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "purge": "tsx scripts/purge.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "csv-parse": "^7.0.3",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.12",
    "fflate": "^0.8.2",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.2"
  }
}
