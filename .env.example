# Node 24+, backend port. All paths are relative to the repository root.
PORT=3000
HOST=0.0.0.0
DATABASE_PATH=data/paloalto.sqlite
SCENES_PATH=shared/scenes.json
# Use the address PHONES can reach. For production use HTTPS.
PUBLIC_URL=http://localhost:5173
# Generate each secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_KEY=replace-with-at-least-32-random-characters
PHONE_HASH_SECRET=replace-with-a-different-32-character-secret
DEMO_MODE=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,onlyoffice://plugin
# Exact proxy hop count, 0 for direct access, 1 for a single reverse proxy.
TRUST_PROXY=0
RETENTION_DAYS=30
