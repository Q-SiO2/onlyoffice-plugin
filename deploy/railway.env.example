# Set these in Railway Variables. Replace the domain and two distinct secrets.
# Stay on Trial/Free; the application does not authorize billing upgrades.
NODE_ENV=production
HOST=0.0.0.0
DATABASE_PATH=/app/data/paloalto.sqlite
SCENES_PATH=shared/scenes.json
DEMO_MODE=false
PUBLIC_URL=https://YOUR-SERVICE.up.railway.app
ALLOWED_ORIGINS=https://YOUR-SERVICE.up.railway.app,onlyoffice://plugin,null
TRUST_PROXY=1
RETENTION_DAYS=30
ADMIN_KEY=replace-with-at-least-32-random-characters
PHONE_HASH_SECRET=replace-with-a-different-32-character-secret
# Railway's documented workaround for volume ownership with a non-root Docker image:
RAILWAY_RUN_UID=0
